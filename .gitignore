# ---- PanHub CLI specific ----
# NEVER commit credentials. The CLI stores session cookies (wxauth-token,
# cf_clearance) on disk; both are real session credentials tied to the
# user's logged-in PanHub account + Cloudflare clearance. Leaking them
# gives anyone full search access through your account.
*.credentials.json
credentials.json
secrets/
.panhub/

# Local config overrides
.env
.env.local
config.local.json
